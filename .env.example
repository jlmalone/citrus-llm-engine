# ====================================
# citrus-llm-engine Configuration
# ====================================

# Application Settings
APP_NAME=citrus-llm-engine
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ====================================
# LLM Provider Configuration
# ====================================
# Options: lmstudio, ollama, openai
LLM_PROVIDER=lmstudio
LLM_MODEL=local-model
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# ====================================
# LM Studio Settings (Local - Default)
# ====================================
# Download LM Studio from: https://lmstudio.ai/
# Start LM Studio, load a model (e.g., llama-3-8b-instruct)
# Enable the local server on port 1234
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=not-needed

# ====================================
# Ollama Settings (Local Alternative)
# ====================================
# Install Ollama from: https://ollama.ai/
# Run: ollama run llama2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ====================================
# OpenAI Settings (Cloud Fallback)
# ====================================
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

# ====================================
# Receipt Extraction Settings
# ====================================
DEFAULT_CURRENCY=USD
CONFIDENCE_THRESHOLD=0.7

# ====================================
# Usage Examples
# ====================================
#
# 1. Using LM Studio (Local):
#    LLM_PROVIDER=lmstudio
#    LLM_MODEL=llama-3-8b-instruct
#
# 2. Using Ollama (Local):
#    LLM_PROVIDER=ollama
#    OLLAMA_MODEL=llama2
#
# 3. Using OpenAI (Cloud):
#    LLM_PROVIDER=openai
#    OPENAI_API_KEY=sk-your-actual-key
#    OPENAI_MODEL=gpt-4
#
