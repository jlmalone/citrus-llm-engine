# =============================================================================
# CITRUS LLM ENGINE - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and configure for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=Citrus LLM Engine
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=8000

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================
# Provider options: lmstudio, ollama, openai
LLM_PROVIDER=lmstudio
LLM_MODEL=llama-3-8b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# -----------------------------------------------------------------------------
# LM Studio Configuration (Local LLM)
# -----------------------------------------------------------------------------
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio

# -----------------------------------------------------------------------------
# Ollama Configuration (Local LLM)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# -----------------------------------------------------------------------------
# OpenAI Configuration (Cloud LLM - Fallback)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# OCR CONFIGURATION
# =============================================================================
# Comma-separated list of OCR engines: tesseract,easyocr,paddleocr
OCR_ENGINES=tesseract,easyocr,paddleocr

# Comma-separated language codes (eng, spa, fra, deu, etc.)
OCR_LANGUAGES=eng

# Minimum confidence threshold (0.0 - 1.0)
OCR_CONFIDENCE_THRESHOLD=0.80

# Apply image preprocessing for better accuracy
OCR_PREPROCESSING=true

# Tesseract path (optional, leave empty for auto-detect)
TESSERACT_PATH=

# =============================================================================
# ML CATEGORIZATION ENGINE
# =============================================================================
# Path to ML category classifier model
CATEGORY_MODEL_PATH=models/category_classifier

# Path to tax mapping data
TAX_MAPPING_PATH=app/ml/data/tax_mappings.json

# Minimum confidence for ML categorization
CATEGORY_CONFIDENCE_THRESHOLD=0.75

# Fallback to LLM if ML confidence is low
USE_LLM_CATEGORIZATION=true

# =============================================================================
# TAX ASSISTANT CONFIGURATION
# =============================================================================
# Supported tax regions: US (IRS), CA (CRA), GB (HMRC)
TAX_REGIONS=US,CA,GB

# Path to tax rules database
TAX_RULES_PATH=app/ml/data/tax_rules

# Default tax year
TAX_YEAR=2024

# =============================================================================
# DATABASE (OPTIONAL)
# =============================================================================
# PostgreSQL connection string (optional for caching)
# DATABASE_URL=postgresql://user:password@localhost:5432/citrus_llm

# Redis connection string (optional for caching)
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SECURITY
# =============================================================================
# API key header name
API_KEY_HEADER=X-API-Key

# CORS allowed origins (comma-separated or * for all)
ALLOWED_ORIGINS=*

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Number of workers (for production deployment)
WORKERS=4

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=100

# =============================================================================
# DEVELOPMENT/TESTING
# =============================================================================
# Enable debug mode for development
# DEBUG=true
# LOG_LEVEL=DEBUG

# Use smaller models for faster testing
# LLM_MODEL=llama-3-8b-instruct
# OLLAMA_MODEL=llama3:8b
