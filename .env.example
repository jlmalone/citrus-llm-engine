# Service Configuration
SERVICE_NAME=citrus-llm-engine
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# LLM Provider Configuration
# Options: lmstudio, ollama, openai, anthropic
LLM_PROVIDER=lmstudio
LLM_MODEL=llama-3-8b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# LM Studio (local)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI (cloud fallback)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic (cloud option)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# OCR Configuration
# Options: tesseract, easyocr, paddleocr, ensemble (uses all with voting)
OCR_ENGINE=ensemble
OCR_LANGUAGES=eng,fra,spa,deu
OCR_DPI=300
OCR_PREPROCESSING=true
OCR_CONFIDENCE_THRESHOLD=0.80

# Tesseract
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANG=eng

# EasyOCR
EASYOCR_GPU=false
EASYOCR_LANGUAGES=en,fr,es,de

# PaddleOCR
PADDLEOCR_USE_GPU=false
PADDLEOCR_LANG=en
PADDLEOCR_USE_ANGLE_CLS=true

# ML Categorization
CATEGORIZATION_MODEL=sentence-transformers/all-MiniLM-L6-v2
CATEGORIZATION_CONFIDENCE_THRESHOLD=0.75
ENABLE_AUTO_CATEGORIZATION=true

# Tax Configuration
ENABLE_TAX_ASSISTANT=true
TAX_JURISDICTIONS=US,CA,GB
DEFAULT_TAX_JURISDICTION=US

# IRS (US) Configuration
IRS_ENABLE_SCHEDULE_C=true
IRS_ENABLE_SCHEDULE_E=true
IRS_STANDARD_MILEAGE_RATE=0.655

# CRA (Canada) Configuration
CRA_ENABLE_T2125=true
CRA_GST_HST_RATE=0.05

# HMRC (UK) Configuration
HMRC_ENABLE_SA103=true
HMRC_VAT_STANDARD_RATE=0.20

# Performance
WORKER_PROCESSES=4
REQUEST_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=100

# Cache
ENABLE_CACHE=true
CACHE_TTL=3600

# Security
API_KEY_REQUIRED=false
API_KEY=your-api-key-here
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
